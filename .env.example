# Google API key, restricted to Maps JavaScript API (map) + Places API (New)
# (address suggestions and location lookup).
# See README.md > "Configuration Google Cloud" for how to create and restrict this key.
# This key is embedded in the client bundle by design (Maps JS API requires it client-side) —
# its protection comes from HTTP referrer + API restrictions in Google Cloud Console,
# NOT from keeping it secret. Never commit a real key to this repository.
VITE_GOOGLE_MAPS_API_KEY=

# Public GA4 measurement ID. Google Analytics stays entirely disabled when this is empty
# and, when configured, is loaded only after the visitor accepts audience measurement.
VITE_GOOGLE_ANALYTICS_ID=
